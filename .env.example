# Copy this file to `.env` and fill in the device. Compose reads `.env` in this
# directory automatically; `.env` itself is gitignored because it names a device
# on your network.

# Wireless adb serial as host:port, or a USB serial. Leave empty to make doctor
# skip the device check; set it to run against the tablet.
AECOINS_DEVICE=

# Maximum tasks a run may attempt (docs/00-brief.md FR-10).
AECOINS_MAX_TASKS_PER_RUN=12

# In-night retry loop: the absolute ceiling on full re-enumerated sweeps (the
# loop normally stops when a sweep makes no progress), and failed attempts of
# one task before it is blacklisted for the rest of the local day. A success
# resets that task's failure streak; its daily max_per_run still bounds
# repeatable rows. Keep the ceiling at or above max_per_run + max_task_attempts
# - 1: completing a family's rounds takes max_per_run sweeps, and a retryable
# failure spends a sweep without completing a round. The shipped minimum is 7
# (six sponsored rounds plus one retry); the default 12 leaves further headroom.
AECOINS_MAX_PASSES=12
AECOINS_MAX_TASK_ATTEMPTS=2

# Wall-clock budget for one night, and the nightly start (local wall clock).
# The 1200 s budget is a safety net, not an expected duration: the measured worst
# night took 6.4 minutes with ten dispatches, and a night with nothing to do exits
# in under a minute. It stays operator-overridable; raise it for a slower device or
# a deliberately larger AECOINS_MAX_PASSES.
# 03:30 local is cron `30 3 * * *`; 0-180 s of jitter makes the actual fire
# 03:30-03:33. The reset is observed at 00:00 device-local. This late slot avoids
# the evening-use window; the in-night retry loop (#123) re-enumerates a retryable
# failure within the same night. An after-reset fire such as 00:20 leaves more room
# for a supervised retry, at the risk of driving a tablet while someone is still
# using it (docs/06-runbook.md §7).
# The jitter is applied by the APScheduler CronTrigger so the start is not
# clockwork; the daily store skips a night that already ran.
AECOINS_RUN_BUDGET_SECONDS=1200
AECOINS_SCHEDULE_TIME=03:30
AECOINS_SCHEDULE_JITTER_SECONDS=180

# Timezone for the local-day boundary, schedule and log timestamps. **Set this to the
# device's own timezone** (`adb shell getprop persist.sys.timezone`, e.g. America/Toronto):
# the daily store's day boundary and the schedule both follow it. If it disagrees with the
# device, a run fires before the device's day has rolled, finds today's coins already
# claimed, and the fresh-day path is never exercised -- the run looks successful and earns
# nothing. AECOINS_TIMEZONE wins over TZ when both are set.
AECOINS_TIMEZONE=UTC

# Run artifact retention: keep this many run directories (including the current
# one) and prune the oldest first.
AECOINS_KEEP_RUNS=30

# Notifications go through your Apprise API server, which owns the actual
# targets (ntfy, mail, Discord, ...). Set the server base URL to enable one
# message per run; leave it empty to turn delivery off entirely. The optional
# key selects a saved Apprise configuration and the tag narrows its destinations.
# A failed delivery is logged in the report and never changes the run's status.
AECOINS_APPRISE_URL=
AECOINS_APPRISE_KEY=
AECOINS_APPRISE_TAG=
# The message never includes the account name or an absolute balance. Set this
# to true to add the balance *delta* (for example +6) when both frames were read.
AECOINS_NOTIFY_BALANCE_DELTA=false
# Legacy webhook/ntfy only: also notify when a completed run claimed nothing.
# Apprise already sends one message for every run, so this setting is unused
# while AECOINS_APPRISE_URL is set.
AECOINS_NOTIFY_ON_EMPTY=false

# Legacy transports from #31 still work, but configure one transport only so a
# run sends one message. They are not needed with an Apprise server.
AECOINS_WEBHOOK_URL=
AECOINS_NTFY_TOPIC=
AECOINS_NTFY_SERVER=https://ntfy.sh

# AECOINS_RUNS_DIR and AECOINS_STATE_DIR are internal container paths pinned by
# compose.yaml to the `runs` and `state` volumes; they are not `.env` settings.
