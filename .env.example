# Copy this file to `.env` and fill in the device. Compose reads `.env` in this
# directory automatically; `.env` itself is gitignored because it names a device
# on your network.

# Wireless adb serial as host:port, or a USB serial. Leave empty to make doctor
# skip the device check; set it to run against the tablet.
AECOINS_DEVICE=

# Maximum tasks a run may attempt (docs/00-brief.md FR-10).
AECOINS_MAX_TASKS_PER_RUN=12

# Wall-clock budget for one night, and the nightly start (local wall clock).
# The jitter is applied by the APScheduler CronTrigger so the start is not
# clockwork; the daily store skips a night that already ran.
AECOINS_RUN_BUDGET_SECONDS=2700
AECOINS_SCHEDULE_TIME=03:30
AECOINS_SCHEDULE_JITTER_SECONDS=180

# Timezone for the local-day boundary, schedule and log timestamps.
TZ=UTC
AECOINS_TIMEZONE=UTC

# AECOINS_RUNS_DIR and AECOINS_STATE_DIR are internal container paths pinned by
# compose.yaml to the `runs` and `state` volumes; they are not `.env` settings.
